rules_version = '2';

// Modelo: boards/{boardId} guarda os membros e seus papéis; groups e tasks herdam
// o acesso do painel pai. Tudo que não for liberado aqui é negado por padrão.
// Os limites de tamanho espelham src/constants/limits.js.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Identidade ----------

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    // Sem e-mail verificado, qualquer um poderia criar conta com o e-mail
    // de terceiros e ler ou aceitar os convites enviados a essa pessoa.
    function emailVerified() {
      return request.auth.token.email_verified == true;
    }

    // ---------- Papéis no painel ----------

    function boardData(boardId) {
      return get(/databases/$(database)/documents/boards/$(boardId)).data;
    }

    function isMember(boardId) {
      return signedIn() && uid() in boardData(boardId).memberIds;
    }

    function canEdit(boardId) {
      return isMember(boardId)
        && boardData(boardId).members[uid()].role in ['owner', 'editor'];
    }

    function isBoardOwner(boardId) {
      return signedIn() && boardData(boardId).ownerId == uid();
    }

    // ---------- Validação ----------

    function isText(value, min, max) {
      return value is string && value.trim().size() >= min && value.size() <= max;
    }

    function hasExactly(data, fields) {
      return data.keys().hasOnly(fields) && data.keys().hasAll(fields);
    }

    function validBoard(data) {
      return hasExactly(data, ['name', 'description', 'ownerId', 'members', 'memberIds', 'createdAt', 'updatedAt'])
        && isText(data.name, 1, 80)
        && isText(data.description, 0, 300)
        && data.ownerId is string
        && data.members is map
        && data.memberIds is list
        && data.memberIds.size() <= 50
        && data.memberIds.size() == data.members.size()
        && data.members.keys().hasAll(data.memberIds)
        && data.ownerId in data.memberIds
        && data.updatedAt == request.time;
    }

    function validGroup(data) {
      return hasExactly(data, ['name', 'color', 'createdBy', 'createdAt', 'updatedAt'])
        && isText(data.name, 1, 60)
        && data.color is string
        && data.color.matches('^#[0-9a-fA-F]{6}$')
        && data.updatedAt == request.time;
    }

    function validTask(data) {
      return hasExactly(data, [
          'groupId', 'title', 'description', 'note', 'subtasks', 'dueDate', 'priority',
          'onComplete', 'status', 'previousStatus', 'order', 'completedAt',
          'createdBy', 'createdAt', 'updatedBy', 'updatedAt'
        ])
        && isText(data.groupId, 1, 128)
        && isText(data.title, 1, 200)
        && isText(data.description, 0, 5000)
        && isText(data.note, 0, 1000)
        && data.subtasks is list
        && data.subtasks.size() <= 50
        && (data.dueDate == null
            || (data.dueDate is string && data.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && data.priority in [1, 2, 3, 4]
        && data.onComplete in ['archive', 'reset']
        && data.status in ['not_started', 'in_progress', 'paused', 'blocked', 'done']
        && (data.previousStatus == null
            || data.previousStatus in ['not_started', 'in_progress', 'paused', 'blocked'])
        && data.order is number
        && (data.completedAt == null || data.completedAt is timestamp)
        // A query do board filtra por completedAt == null: os dois campos precisam concordar.
        && (data.status == 'done') == (data.completedAt != null)
        && data.updatedBy == uid()
        && data.updatedAt == request.time;
    }

    function validInvite(data, inviteId) {
      return hasExactly(data, [
          'boardId', 'boardName', 'email', 'role', 'status',
          'invitedBy', 'invitedByName', 'createdAt', 'respondedAt'
        ])
        && inviteId == data.boardId + '_' + data.email
        && isText(data.boardName, 1, 80)
        && isText(data.email, 3, 254)
        && data.email == data.email.lower()
        && data.email != myEmail()
        && data.role in ['editor', 'viewer']
        && data.status == 'pending'
        && data.invitedBy == uid()
        && isText(data.invitedByName, 1, 120)
        && data.createdAt == request.time
        && data.respondedAt == null;
    }

    // ---------- Transições do painel ----------

    // O dono edita o painel, muda papéis e remove membros, mas não adiciona
    // ninguém diretamente: a entrada de membros só acontece via convite.
    function ownerUpdate() {
      let before = resource.data;
      let after = request.resource.data;
      return before.ownerId == uid()
        && after.diff(before).affectedKeys()
             .hasOnly(['name', 'description', 'members', 'memberIds', 'updatedAt'])
        && after.members.diff(before.members).addedKeys().size() == 0
        && after.members[uid()] == before.members[uid()];
    }

    function onlyMyMembershipChanges() {
      let before = resource.data;
      let after = request.resource.data;
      return after.diff(before).affectedKeys().hasOnly(['members', 'memberIds', 'updatedAt'])
        && after.members.diff(before.members).affectedKeys().hasOnly([uid()]);
    }

    function leavingBoard() {
      return resource.data.ownerId != uid()
        && uid() in resource.data.memberIds
        && !(uid() in request.resource.data.memberIds)
        && onlyMyMembershipChanges();
    }

    // Aceite é um batch: o convite passa de pending para accepted junto com a entrada
    // no painel. Por isso um convite não pode ser reutilizado depois de uma remoção.
    function acceptingInvite(boardId) {
      let invitePath = /databases/$(database)/documents/invites/$(boardId + '_' + myEmail());
      let invite = get(invitePath).data;
      let entry = request.resource.data.members[uid()];
      return emailVerified()
        && !(uid() in resource.data.memberIds)
        && onlyMyMembershipChanges()
        && invite.status == 'pending'
        && getAfter(invitePath).data.status == 'accepted'
        && entry.role == invite.role
        && entry.email == myEmail();
    }

    // ---------- Coleções ----------

    match /boards/{boardId} {
      allow read: if signedIn() && uid() in resource.data.memberIds;

      allow create: if signedIn()
        && validBoard(request.resource.data)
        && request.resource.data.ownerId == uid()
        && request.resource.data.memberIds == [uid()]
        && request.resource.data.members[uid()].role == 'owner'
        && request.resource.data.createdAt == request.time;

      allow update: if signedIn()
        && validBoard(request.resource.data)
        && (ownerUpdate() || leavingBoard() || acceptingInvite(boardId));

      allow delete: if signedIn() && resource.data.ownerId == uid();

      match /groups/{groupId} {
        allow read: if isMember(boardId);

        allow create: if canEdit(boardId)
          && validGroup(request.resource.data)
          && request.resource.data.createdBy == uid()
          && request.resource.data.createdAt == request.time;

        allow update: if canEdit(boardId)
          && validGroup(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['name', 'color', 'updatedAt']);

        allow delete: if canEdit(boardId);
      }

      match /tasks/{taskId} {
        function groupExists(groupId) {
          return exists(/databases/$(database)/documents/boards/$(boardId)/groups/$(groupId));
        }

        allow read: if isMember(boardId);

        allow create: if canEdit(boardId)
          && validTask(request.resource.data)
          && groupExists(request.resource.data.groupId)
          && request.resource.data.createdBy == uid()
          && request.resource.data.createdAt == request.time;

        allow update: if canEdit(boardId)
          && validTask(request.resource.data)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && (request.resource.data.groupId == resource.data.groupId
              || groupExists(request.resource.data.groupId));

        allow delete: if canEdit(boardId);
      }
    }

    match /invites/{inviteId} {
      function isRecipient() {
        return signedIn() && emailVerified() && resource.data.email == myEmail();
      }

      function isSender() {
        return signedIn() && resource.data.invitedBy == uid();
      }

      function responding() {
        return resource.data.status == 'pending'
          && request.resource.data.status in ['accepted', 'declined']
          && request.resource.data.respondedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'respondedAt']);
      }

      allow read: if isRecipient() || isSender();

      allow create: if signedIn()
        && validInvite(request.resource.data, inviteId)
        && isBoardOwner(request.resource.data.boardId);

      // O dono pode reenviar um convite recusado ou reconvidar quem saiu do painel.
      allow update: if (isRecipient() && responding())
        || (isSender()
            && validInvite(request.resource.data, inviteId)
            && isBoardOwner(request.resource.data.boardId));

      allow delete: if isSender();
    }
  }
}
