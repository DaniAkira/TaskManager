# Copie para .env.local e preencha com os dados do app web do seu projeto Firebase.
# Console > Configurações do projeto > Seus apps > Configuração do SDK.
# Estes valores identificam o projeto e vão para o bundle: quem protege os dados são as Security Rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
